---
import type { HeroProps } from "@types";

interface Props {
  hero: HeroProps;
}

const { hero } = Astro.props;
const { nombre, especialidad, resumen } = hero;
---

<section class="mx-auto max-w-3xl py-24 md:py-32" id="hero">
  <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
  >
    {nombre}
  </h1>
  <p
    class="mb-9 font-serif text-4xl leading-11.5 font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    {especialidad}
  </p>
  <p class="mb-16 text-base font-normal text-neutral md:text-lg">
    {resumen}
  </p>

  <a
    class="inline-block rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff] hover:bg-primary/50 transition"
    href="#about">Sobre mí</a
  >
</section>

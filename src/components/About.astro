---
import Image from "astro/components/Image.astro";
import type { ConocimientosProps, EstudiosProps } from "@types";

interface Props {
  estudios: EstudiosProps[];
  conocimientos: ConocimientosProps[];
}

const { estudios, conocimientos } = Astro.props;
const conocimientosTipo = Object.groupBy(
  conocimientos,
  (conocimiento) => conocimiento.tipo,
);
---

<section class="scroll-mt-32 mb-24" id="about">
  <h2
    class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
  >
    Sobre mí
  </h2>
  <div class="mx-auto grid grid-cols-1 gap-10 md:grid-cols-2">
    <div class="flex flex-col">
      <h3 class="mb-8 text-lg font-bold text-white">Mis estudios</h3>
      <ol class="relative flex flex-col flex-1 justify-between gap-6">
        <li
          aria-hidden="true"
          class="absolute left-0 top-1.5 bottom-1.5 w-px bg-linear-to-b from-transparent via-primary/50 to-transparent"
        ></li>
        {
          estudios.map(({ nombre, centro, inicio, fin, descripcion }) => (
            <li class="relative pl-6">
              <span
                aria-hidden="true"
                class="absolute left-0 top-1.5 h-3 w-3 -translate-x-1/2 rounded-full bg-primary ring-4 ring-primary/20"
              />
              <div class="rounded-2xl border border-neutral/20 bg-card-background/85 p-4 transition-colors hover:border-primary/40">
                <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                  <div>
                    <h4 class="font-serif font-semibold text-white">
                      {nombre}
                    </h4>
                    <p class="mt-0.5 text-sm text-neutral">{centro}</p>
                  </div>
                  <span class="shrink-0 self-start rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
                    {inicio} - {fin}
                  </span>
                </div>
                <p class="mt-3 text-base text-neutral">{descripcion}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="flex flex-col">
      <div class="flex flex-col flex-1 justify-between gap-6">
        {
          Object.entries(conocimientosTipo).map(([tipo, items]) => (
            <div>
              <h3 class="col-span-5 text-lg font-bold text-white mb-8">{tipo}</h3>
              <div class="grid grid-cols-3 md:grid-cols-5 gap-6">
              {items.map(({ nombre, imagen }) => (
                <div class="w-24 h-24 rounded-2xl border border-neutral/20 bg-card-background/85 hover:border-primary/40 flex flex-col items-center justify-evenly p-2">
                  <div class="flex items-center justify-center w-12 h-12">
                    <Image
                      alt={`Logo de ${nombre}`}
                      src={imagen}
                      class="w-full h-full object-contain"
                    />
                  </div>
                  <span class="text-white text-center text-[12px]">{nombre}</span>
                </div>
              ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

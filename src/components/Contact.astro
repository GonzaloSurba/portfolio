---
import type { ContactProps } from "@types";

interface Props {
  contacto: ContactProps;
}

const { contacto } = Astro.props;
const { email } = contacto;
---

<section class="scroll-mt-32 mb-24" id="form-contact">
  <h2
    class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
  >
    Contacto
  </h2>
  <form
    method="POST"
    class="md:w-1/3 m-auto bg-black p-3 flex flex-col [&>.campo]:bg-card-background/85 [&>.campo]:border [&>.campo]:border-neutral/20 [&>.campo]:rounded-2xl [&>.campo]:text-neutral *:mb-4 *:p-2"
  >
    <input
      type="text"
      name="name"
      id="name"
      autocomplete="name"
      placeholder="Nombre"
      class="campo"
      required
    />
    <input
      type="email"
      name="email"
      id="email"
      autocomplete="email"
      placeholder="Correo electrónico"
      class="campo"
      required
    />
    <textarea
      name="message"
      id="message"
      placeholder="Mensaje"
      class="campo"
      required></textarea>
    <button
      type="submit"
      class="rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff] cursor-pointer hover:bg-primary/50 transition"
      >Enviar</button
    >
    <p class="text-red-500 hidden" id="result"></p>
    <p class="text-xs text-neutral p-2">
      También puedes contactar conmigo a través de mi correo <span
        class="text-primary">{email}</span
      >.
    </p>
  </form>
</section>

<script>
  const form = document.querySelector("form") as HTMLFormElement;
  const btnSubmit = document.querySelector(
    'button[type="submit"]',
  ) as HTMLButtonElement;
  const result = document.querySelector("#result");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!result) return;

    if (!btnSubmit) return;
    btnSubmit.disabled = true;
    btnSubmit.textContent = "Enviando...";

    const formData = new FormData(form);
    formData.append("access_key", "0dc13383-331c-4265-8a98-cf3a4a3fcfd3");

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      result.classList.remove("hidden");
      if (response.ok) {
        result.textContent = "Tu mensaje ha sido enviado";
        form.reset();
      } else {
        if (data.message) {
          result.textContent = "Error: " + data.message;
        } else {
          result.textContent = "Se ha producido un error";
        }
      }
    } catch (error) {
      result.textContent =
        "Se ha producido un error. Vuelve a intentarlo más tarde.";
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.textContent = "Enviar";
    }
  });
</script>

---
import type { ExperienciaProps } from "@types";

interface Props {
  experiencia: ExperienciaProps[];
}

const { experiencia } = Astro.props;
---

<section class="scroll-mt-32 mb-24" id="experiencia">
  <h2
    class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
  >
    Mi experiencia
  </h2>
      {
        experiencia.map(({ empresa, tipo, inicio, fin, descripcion }) => {
          return (
            <div class="mb-6">
              <h3 class="mb-1.5 font-serif text-2xl font-semibold text-white">
                {empresa}
              </h3>
              <div class="flex flex-col items-start pb-5">
                <h4 class="mb-0.5 font-serif text-2xl font-medium text-primary">
                  {tipo}
                </h4>
                <span class="pb-0.5 text-sm text-white/70">
                  {inicio} — {fin}
                </span>
              </div>
              <p class="text-base text-neutral">{descripcion}</p>
            </div>
          );
        })
      }
</section>

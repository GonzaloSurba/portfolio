---
import Header from "../components/Header.astro";
import imagenPerfil from "../assets/perfil.jpg";
import Footer from "../components/Footer.astro";

import { navLinks, socialLinks } from "@content";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/portfolio/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta name="description" content="Gonzalo Suárez Barrientos - Desarrollador web y administrador de sistemas. Creación de aplicaciones web con React, Astro, Tailwind CSS, PHP y Python." />
    <meta name="author" content="Gonzalo Suárez Barrientos" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://gonzalosurba.github.io/portfolio/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Gonzalo Suárez | Desarrollador web y administrador de sistemas" />
    <meta property="og:description" content="Creación de aplicaciones web con React, Astro, Tailwind CSS, PHP y Python. Especializado en gestión de servidores y despliegue en la nube." />
    <meta property="og:url" content="https://gonzalosurba.github.io/portfolio/" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Gonzalo Suárez" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Gonzalo Suárez | Desarrollador web y administrador de sistemas" />
    <meta name="twitter:description" content="Creación de aplicaciones web con React, Astro, Tailwind CSS, PHP y Python." />
    
    <title>Gonzalo Suárez | Desarrollador web y administrador de sistemas</title>
  </head>
  <body class="bg-black font-sans">
    <Header imagen={imagenPerfil} navLinks={navLinks} />
    <main class="mx-auto max-w-7xl px-5">
      <slot />
    </main>
    <Footer autor={"Gonzalo Suárez"} socialLinks={socialLinks} />
  </body>
</html>
